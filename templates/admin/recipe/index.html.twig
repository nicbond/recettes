{% extends 'admin/admin.html.twig' %}

{% block title %}Toutes les recettes{% endblock %}

{% block body %}
    <style>
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('admin.recipe.create') }}" class="btn btn-primary">Ajouter une nouvelle recette</a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Titre</th>
            <th>Catégorie</th>
            <th style="width: 200px">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for recipe in recipes %}
            <tr>
                <th>
                    {{ recipe.title }}
                </th>
                <th>
                    {{ recipe.category.name | default('') }}
                </th>
                <th>
                    <div class="btn-group">
                        <a class="btn btn-primary" href="{{ path('admin.recipe.edit', {id: recipe.id}) }}">
                            <i class="fas fa-edit"></i>
                        </a>
                    </div>
                    <div class="btn-group">
                        {% include('components/modal/_delete_from_index_form.html.twig') with {
                            icon: true,
                            id: recipe.id,
                            route: 'admin.recipe.delete',
                            message: 'Cette recette sera définitivement supprimée et ne sera plus affichée.<br><br>Êtes-vous certain de vouloir procéder à la suppression ?'
                        } %}
                    </div>
                </th>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
