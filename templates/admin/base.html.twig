{% extends 'base.html.twig' %}

{% block title %}{% block admin_title %}Administration{% endblock %}{% endblock %}

{% block body %}

    {# State detection: Full access if NOT on the maintenance page #}
    {% set has_full_access = app.request.attributes.get('has_full_access')|default(false) %}

    <div class="admin-layout">

        {# ==========================================================
                   SIDEBAR
        ========================================================== #}
        <aside class="admin-sidebar">

            {% if has_full_access and is_granted('ROLE_ADMIN') %}
                <div class="admin-sidebar-header">
                    <a href="{{ path('admin.recipe.index') }}" class="admin-brand">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span>Administration</span>
                    </a>
                </div>
            {% endif %}

            {# Navigation - Visible ONLY if the IP is authorized and accessing the site #}
            <nav class="admin-nav">
                {% if has_full_access and is_granted('ROLE_ADMIN') %}

                    <div class="admin-nav-section">
                        <span class="admin-nav-section-title">
                            Gestion
                        </span>

                        <a href="{{ path('contact') }}"
                           class="admin-nav-link {{ app.current_route starts with 'contact' ? 'active' : '' }}">
                            <i class="fa-solid fa-address-book"></i>
                            <span>Contact</span>
                        </a>

                        {# Dropdown Recipes #}
                        <div class="admin-nav-dropdown {{ app.current_route starts with 'admin.recipe.' or app.current_route starts with 'admin.category.' ? 'open' : '' }}">

                            <button
                                    class="admin-nav-link admin-nav-dropdown-toggle {{ app.current_route starts with 'admin.recipe.' or app.current_route starts with 'admin.category.' ? 'active' : '' }}"
                                    type="button"
                                    onclick="this.closest('.admin-nav-dropdown').classList.toggle('open')"
                            >
                                <i class="fa-solid fa-book-open"></i>
                                <span>Recettes</span>
                                <i class="fa-solid fa-chevron-down admin-nav-chevron"></i>
                            </button>

                            <div class="admin-nav-dropdown-menu">

                                <a href="{{ path('admin.recipe.index') }}"
                                   class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.recipe.' ? 'active' : '' }}">
                                    <i class="fa-solid fa-utensils"></i>
                                    <span>Liste des recettes</span>
                                </a>

                                <a href="{{ path('admin.category.index') }}"
                                   class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.category.' ? 'active' : '' }}">
                                    <i class="fa-solid fa-layer-group"></i>
                                    <span>Liste des catégories</span>
                                </a>

                                <a href="{{ path('admin.tag.index') }}"
                                   class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.tag.' ? 'active' : '' }}">
                                    <i class="fa-solid fa-hashtag"></i>
                                    <span>Liste des tags</span>
                                </a>

                            </div>
                        </div>

                    </div>

                {% endif %}
            </nav>

            {# Bottom of the sidebar #}
            <div class="admin-sidebar-footer">

                {% if has_full_access and is_granted('ROLE_ADMIN') %}

                    <a href="{{ path('admin_security_2fa') }}"
                       class="admin-nav-link {{ app.current_route == 'admin_security_2fa' ? 'active' : '' }}">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Double authentification</span>
                    </a>

                    <a href="{{ path('home') }}" class="admin-nav-link">
                        <i class="fa-solid fa-house"></i>
                        <span>Retour à l'accueil</span>
                    </a>

                    <a href="{{ path('app_logout') }}" class="admin-nav-link logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Se déconnecter</span>
                    </a>

                {% endif %}

            </div>

        </aside>

        {# ==========================================================
                  MAIN CONTENT
        ========================================================== #}
        <div class="admin-content">

            <main class="admin-main">

                {{ include('partials/flash.html.twig') }}

                {% block admin_body %}{% endblock %}

            </main>

        </div>

    </div>

{% endblock %}
