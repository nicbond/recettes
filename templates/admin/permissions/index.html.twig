{% extends 'admin/base.html.twig' %}

{% block admin_title %}Gestion des permissions{% endblock %}

{% block admin_body %}
    <h1>Gestion des permissions</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">

            {{ form_start(filterForm, {
                attr: {
                    class: 'row g-3 align-items-center',
                },
            }) }}

            <div class="col-md-6">
                {{ form_widget(filterForm.email) }}
            </div>

            <div class="col-md-auto d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter me-1"></i>
                    Filtrer
                </button>

                <a href="{{ path('admin.permissions.index') }}"
                   class="btn btn-outline-danger"
                   title="Réinitialiser tous les filtres"
                   aria-label="Réinitialiser les filtres">
                    <i class="fas fa-times"></i>
                </a>
            </div>

            {{ form_end(filterForm) }}

        </div>
    </div>

    <div class="border-top border-primary border-3 pt-3">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>
                    {{ knp_pagination_sortable(pagination, 'Email', 'admin.email') }}
                    <i class="fas fa-{{ sortDirectionIcon('admin.email', pagination.params) }}"></i>
                </th>
                <th>Rôle</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for admin in pagination %}
                <tr>
                    <td>{{ admin.email }}</td>
                    <td>
                        {% if admin.isSuperAdmin() %}
                            <span class="badge bg-danger">Super Admin</span>
                        {% else %}
                            <span class="badge bg-primary">Admin</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if admin.isSuperAdmin() %}
                            <span class="text-muted">Toutes les permissions</span>
                        {% else %}
                            {{ admin.permissions|length }} permission(s)
                        {% endif %}
                    </td>
                    <td>
                        {% if not admin.isSuperAdmin() %}
                            <a href="{{ path('admin.permissions.edit', {id: admin.id}) }}"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i> Gérer
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        {{ include('components/pagination/pagination.html.twig', {pagination: pagination}) }}
    </div>
{% endblock %}
