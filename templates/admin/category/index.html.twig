{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
    <h1>Liste des catégories</h1>

    <div class="filter-bar-container">
        <div class="filter-bar-body">
            {{ form_start(filterForm, {
                attr: {
                    class: 'row g-2 align-items-center',
                },
            }) }}

            <div class="col-md-auto filter-bar-select-width">
                <div class="position-relative">
                    {{ form_widget(filterForm.category) }}
                </div>
            </div>

            <div class="col-md-auto filter-bar-actions">
                <button type="submit" class="btn btn-primary d-flex align-items-center">
                    <i class="fas fa-filter me-2"></i>
                    Filtrer
                </button>

                <a href="{{ path('admin.category.index') }}"
                   class="btn btn-danger d-flex align-items-center justify-content-center"
                   title="Réinitialiser tous les filtres"
                   aria-label="Réinitialiser les filtres">
                    <i class="fas fa-times"></i>
                </a>
            </div>

            {{ form_end(filterForm) }}
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('admin.category.create') }}" class="btn btn-primary">Ajouter une nouvelle catégorie</a>
    </div>

    <div class="border-top border-primary border-3">
        <div class="box-body">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th scope="col">
                        {{ knp_pagination_sortable(pagination, 'Catégorie', 'category.name') }}
                        <i class="fas fa-{{ sortDirectionIcon('category.name', pagination.params) }}"></i>
                    </th>
                    <th class="table-actions-col">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for category in pagination %}
                    <tr>
                        <th scope="row">{{ category.name }}</th>
                        <th>
                            <div class="d-flex gap-2">
                                <a class="btn btn-primary btn-sm" href="{{ path('admin.category.edit', {id: category.id}) }}">
                                    <i class="fas fa-edit"></i>
                                </a>

                                {% if category.recipes|length > 0 %}
                                    {{ include('components/modal/category/_cannot_delete_form.html.twig', {
                                        icon: true,
                                        id: category.id,
                                        name: category.name,
                                        recipes: category.recipes,
                                        warning: 'Désolé, vous ne pouvez pas supprimer cette catégorie',
                                        reason: 'car celle-ci est liée aux recettes suivantes :',
                                        message: 'Veuillez d\'abord modifier ou supprimer ces recettes avant de supprimer ctte catégorie.',
                                    }) }}
                                {% else %}
                                    {{ include('components/modal/_delete_from_index_form.html.twig', {
                                        icon: true,
                                        id: category.id,
                                        route: 'admin.category.delete',
                                        message: 'Cette catégorie sera définitivement supprimée et ne sera plus affichée.<br><br>Êtes-vous certain de vouloir procéder à la suppression ?',
                                    }) }}
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        {{ include('components/pagination/pagination.html.twig', {pagination: pagination}) }}
    </div>
{% endblock %}
