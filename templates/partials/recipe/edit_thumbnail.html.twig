{% extends 'base.html.twig' %}

{% block body %}
    <turbo-frame id="modal">
        <div class="modal-header d-flex justify-content-between align-items-center">
            <h5 class="modal-title modal-title-centered">Modifier l'image de {{ recipe.title }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
            <div class="row align-items-center g-4">
                <div class="col-md-5 text-center">
                    <div id="thumbnail-preview-container">
                        {% if recipe.thumbnail.name %}
                            <img id="thumbnail-preview"
                                 src="{{ vich_uploader_asset(recipe, 'thumbnailFile') }}"
                                 class="img-fluid rounded shadow-sm w-100 modal-thumbnail-preview"
                                 alt="{{ recipe.title }}">
                        {% else %}
                            <div id="thumbnail-preview"
                                 class="rounded shadow-sm w-100 modal-thumbnail-placeholder">
                                <i class="fas fa-utensils fa-5x"></i>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-7">
                    {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
                    <div class="mb-3">
                        {{ form_row(form.thumbnailFile) }}
                    </div>
                    <div class="modal-actions-container">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Mettre à jour l'image
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>

            </div>
        </div>
    </turbo-frame>
{% endblock %}
