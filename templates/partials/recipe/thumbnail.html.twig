<div id="thumbnail-preview-container"
     class="bg-secondary d-flex align-items-center justify-content-center mb-3"
     style="width: 200px; height: 200px; overflow: hidden;">
    {% if recipe is defined and recipe.thumbnail is defined and recipe.thumbnail.name %}
        <img id="thumbnail-preview"
             src="{{ vich_uploader_asset(recipe, 'thumbnailFile') }}"
             alt="Aperçu de la recette {{ recipe.title }}"
             style="width: 100%; height: 100%; object-fit: cover;">
    {% else %}
        <i id="thumbnail-placeholder" class="fas fa-utensils fa-3x text-white"></i>
    {% endif %}
</div>
