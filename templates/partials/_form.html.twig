{{ form_start(form, {attr: {
    'data-turbo': 'false',
}}) }}
    {{ form_errors(form) }}

    {% for child in form %}
        {# Check if the field has already been rendered elsewhere on the page #}
        {% if not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}

    {% if not show %}
        <button class="btn btn-primary float-right">{{ button_label|default('Enregistrer') }}</button>
    {% endif %}
{{ form_end(form) }}
