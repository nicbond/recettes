{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <div class="login-page">
        <div class="login-card">

            <div class="login-logo">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <h1 class="login-card__title">Réinitialiser votre mot de passe</h1>

            <p class="login-card__subtitle">
                Renseignez vos informations pour créer un compte administrateur
            </p>

            {{ form_start(resetForm, {attr: {novalidate: 'novalidate'}}) }}

            <div class="mb-3">
                {{ form_label(resetForm.plainPassword.first) }}

                <div
                        data-controller="password-visibility"
                        class="password-field"
                >
                    {{ form_widget(resetForm.plainPassword.first, {
                        attr: {
                            'data-password-visibility-target': 'input',
                        },
                    }) }}

                    <button
                            type="button"
                            class="password-field__toggle"
                            data-action="click->password-visibility#toggle"
                            aria-label="Afficher le mot de passe"
                            title="Afficher le mot de passe"
                    >
                        <i
                                class="fa-solid fa-eye-slash"
                                data-password-visibility-target="icon"
                        ></i>
                    </button>
                </div>

                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    {{ form_errors(resetForm.plainPassword.first) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(resetForm.plainPassword.second) }}

                <div
                        data-controller="password-visibility"
                        class="password-field"
                >
                    {{ form_widget(resetForm.plainPassword.second, {
                        attr: {
                            'data-password-visibility-target': 'input',
                        },
                    }) }}

                    <button
                            type="button"
                            class="password-field__toggle"
                            data-action="click->password-visibility#toggle"
                            aria-label="Afficher le mot de passe"
                            title="Afficher le mot de passe"
                    >
                        <i
                                class="fa-solid fa-eye-slash"
                                data-password-visibility-target="icon"
                        ></i>
                    </button>
                </div>

                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    {{ form_errors(resetForm.plainPassword.second) }}
                </div>
            </div>

            <button class="login-card_btn" type="submit">
                <i class="fa-solid fa-user-plus me-2"></i>
                Réinitialiser votre mot de passe
            </button>

            {{ form_end(resetForm) }}

            <div class="login-footer">
                Administration © {{ 'now'|date('Y') }}
            </div>

        </div>
    </div>
{% endblock %}
