{% extends 'base.html.twig' %}

{% block title %}E-mail de réinitialisation envoyé{% endblock %}

{% block body %}
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>

            <h1>E-mail envoyé</h1>

            <p class="login-subtitle text-start mb-4">
                Si un compte correspond à l'adresse saisie, un mail vient de vous être envoyé.<br>
                Il contient un lien sécurisé permettant de réinitialiser votre mot de passe.
            </p>

            <div class="alert alert-info text-start small mb-4" role="alert">
                <i class="fa-solid fa-clock me-1"></i>
                Ce lien sécurisé expirera dans : <strong>30 minutes</strong>.
            </div>

            <p class="text-muted small text-start mb-4">
                Si vous ne recevez rien d'ici quelques minutes, pensez à vérifier vos courriers indésirables (spams) ou <a href="{{ path('app_forgot_password_request') }}" class="fw-bold">réessayez</a>.
            </p>

            <div class="login-footer border-top pt-3">
                <a href="{{ path('app_login') }}">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
{% endblock %}
