{% extends 'admin/base.html.twig' %}

{% block admin_title %}Accueil{% endblock %}

{% block admin_body %}
    {% if app.user %}
        <h1>Bienvenue {{ app.user.email }}</h1>

        {% if not app.user.googleAuthenticatorEnabled %}
            <div class="alert alert-info mt-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="fs-4">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div class="flex-grow-1">
                        <h2 class="h5 mb-2">
                            Sécurisez votre compte
                        </h2>

                        <p class="mb-3">
                            La double authentification n'est pas encore activée
                            sur votre compte.
                            Ajoutez une protection supplémentaire avec
                            Google Authenticator.
                        </p>

                        <a
                            href="{{ path('admin_security_2fa') }}"
                            class="btn btn-primary"
                        >
                            Activer la double authentification
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}

    <h2 class="mt-4">Bientôt un dashboard</h2>
{% endblock %}
