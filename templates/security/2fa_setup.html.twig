{% extends 'admin/base.html.twig' %}

{% block title %}Activer la double authentification{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <h1 class="mb-4">
                    Activer la double authentification
                </h1>

                <p class="mb-4">
                    Scannez le QR code avec votre application
                    d'authentification, puis saisissez le code
                    à 6 chiffres affiché par celle-ci.
                </p>

                <div class="text-center mb-4">
                    <img
                        src="{{ qrDataUri }}"
                        alt="QR code de configuration de la double authentification"
                        width="300"
                        height="300"
                    >
                </div>

                <div class="alert alert-secondary mb-4">
                    <div class="fw-bold mb-2">
                        Impossible de scanner le QR code ?
                    </div>

                    <p class="mb-2">
                        Vous pouvez saisir manuellement cette clé
                        dans votre application d'authentification :
                    </p>

                    <div>
                        <code class="user-select-all">
                            {{ secret }}
                        </code>
                    </div>
                </div>

                {{ form_start(form) }}
                {{ form_row(form.code) }}

                <button
                    type="submit"
                    class="btn btn-primary w-100"
                >
                    Activer la double authentification
                </button>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
