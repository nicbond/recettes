{% extends 'admin/base.html.twig' %}

{% block title %}Vérification en deux étapes{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="card">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-4">Vérification en deux étapes</h1>

                        <p class="mb-4">
                            Saisissez le code à 6 chiffres affiché
                            dans votre application d'authentification.
                        </p>

                        {% if authenticationError is defined and authenticationError %}
                            <div class="alert alert-danger">
                                {{ authenticationError|trans({}, 'SchebTwoFactorBundle') }}
                            </div>
                        {% endif %}

                        <form action="{{ path('2fa_login_check') }}" method="post">
                            <div class="mb-3">
                                <label for="_auth_code" class="form-label">
                                    Code de vérification
                                </label>

                                <input
                                    type="text"
                                    id="_auth_code"
                                    name="_auth_code"
                                    class="form-control"
                                    autocomplete="one-time-code"
                                    inputmode="numeric"
                                    maxlength="6"
                                    pattern="[0-9]{6}"
                                    required
                                    autofocus
                                >
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Vérifier
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
