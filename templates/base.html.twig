<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Administration{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

    {# Bootstrap #}
    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
    >

    {# Font Awesome #}
    <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
            integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
    >

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>

<body>

{# State detection: Full access if NOT on the maintenance page #}
{% set has_full_access = app.current_route != 'maintenance' %}

<div class="admin-layout">

    {# ==========================================================
               SIDEBAR
    ========================================================== #}
    <aside class="admin-sidebar">

        {% if has_full_access %}
            {# Logo / title - Always visible (authorized IP sees everything; blocked IP sees an empty column with just this title) #}
            <div class="admin-sidebar-header">
                <a href="{{ path('admin.recipe.index') }}" class="admin-brand">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                    <span>Administration</span>
                </a>
            </div>
        {% endif %}

        {# Navigation - Visible ONLY if the IP is authorized and accessing the site #}
        <nav class="admin-nav">
            {% if has_full_access %}
                <div class="admin-nav-section">
                    <span class="admin-nav-section-title">
                        Gestion
                    </span>

                    <a href="{{ path('contact') }}"
                       class="admin-nav-link {{ app.current_route starts with 'contact' ? 'active' : '' }}">
                        <i class="fa-solid fa-address-book"></i>
                        <span>Contact</span>
                    </a>

                    {# Dropdown Recipes #}
                    <div class="admin-nav-dropdown {{ app.current_route starts with 'admin.recipe.' or app.current_route starts with 'admin.category.' ? 'open' : '' }}">
                        <button
                                class="admin-nav-link admin-nav-dropdown-toggle {{ app.current_route starts with 'admin.recipe.' or app.current_route starts with 'admin.category.' ? 'active' : '' }}"
                                type="button"
                                onclick="this.closest('.admin-nav-dropdown').classList.toggle('open')"
                        >
                            <i class="fa-solid fa-book-open"></i>
                            <span>Recettes</span>
                            <i class="fa-solid fa-chevron-down admin-nav-chevron"></i>
                        </button>

                        <div class="admin-nav-dropdown-menu">
                            <a href="{{ path('admin.recipe.index') }}" class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.recipe.' ? 'active' : '' }}">
                                <i class="fa-solid fa-utensils"></i>
                                <span>Liste des recettes</span>
                            </a>

                            <a href="{{ path('admin.category.index') }}" class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.category.' ? 'active' : '' }}">
                                <i class="fa-solid fa-layer-group"></i>
                                <span>Liste des catégories</span>
                            </a>

                            <a href="{{ path('admin.tag.index') }}" class="admin-nav-link admin-nav-sublink {{ app.current_route starts with 'admin.tag.' ? 'active' : '' }}">
                                <i class="fa-solid fa-hashtag"></i>
                                <span>Liste des tags</span>
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </nav>

        {# Bottom of the sidebar - Visible ONLY if the IP is authorized and accessing the site #}
        <div class="admin-sidebar-footer">
            {% if has_full_access %}
                <a href="{{ path('home') }}" class="admin-nav-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Retour à l'accueil</span>
                </a>
            {% endif %}
        </div>
    </aside>

    {# ==========================================================
              MAIN CONTENT
    ========================================================== #}
    <div class="admin-content">

        <main class="admin-main">

            {{ include('partials/flash.html.twig') }}

            {% block body %}{% endblock %}

        </main>

    </div>

</div>

<script
        src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.min.js"
        integrity="sha512-nKXmKvJyiGQy343jatQlzDprflyB5c+tKCzGP3Uq67v+lmzfnZUi/ZT+fc6ITZfSC5HhaBKUIvr/nTLCV+7F+Q=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
></script>

</body>
</html>
