{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="login-page">
        <div class="login-card">

            <div class="login-logo">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <h1 class="login-card__title">Créer un compte</h1>

            <p class="login-card__subtitle">
                Renseignez vos informations pour créer un compte administrateur
            </p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {
                    attr: {
                        placeholder: 'admin@exemple.fr',
                    },
                }) }}

                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    {{ form_errors(form.email) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.first) }}

                <div
                        data-controller="password-visibility"
                        class="password-field"
                >
                    {{ form_widget(form.plainPassword.first, {
                        attr: {
                            'data-password-visibility-target': 'input',
                        },
                    }) }}

                    <button
                            type="button"
                            class="password-field__toggle"
                            data-action="click->password-visibility#toggle"
                            aria-label="Afficher le mot de passe"
                            title="Afficher le mot de passe"
                    >
                        <i
                                class="fa-solid fa-eye"
                                data-password-visibility-target="icon"
                        ></i>
                    </button>
                </div>

                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    {{ form_errors(form.plainPassword.first) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.plainPassword.second) }}

                <div
                        data-controller="password-visibility"
                        class="password-field"
                >
                    {{ form_widget(form.plainPassword.second, {
                        attr: {
                            'data-password-visibility-target': 'input',
                        },
                    }) }}

                    <button
                            type="button"
                            class="password-field__toggle"
                            data-action="click->password-visibility#toggle"
                            aria-label="Afficher le mot de passe"
                            title="Afficher le mot de passe"
                    >
                        <i
                                class="fa-solid fa-eye"
                                data-password-visibility-target="icon"
                        ></i>
                    </button>
                </div>

                <div class="text-danger mt-1" style="font-size: 0.85rem;">
                    {{ form_errors(form.plainPassword.second) }}
                </div>
            </div>

            <button class="login-card_btn" type="submit">
                <i class="fa-solid fa-user-plus me-2"></i>
                S'inscrire
            </button>

            {{ form_end(form) }}

            <div class="login-footer">
                Déjà un compte ?
                <a href="{{ path('app_login') }}">Se connecter</a>
            </div>

            <div class="login-footer">
                Administration © {{ 'now'|date('Y') }}
            </div>

        </div>
    </div>
{% endblock %}
